# Environment Configuration Template
# Copy this file to .env and adjust as needed.
# NEVER commit your real .env file to git — it's already in .gitignore.

# Application environment: development / production
ENVIRONMENT=development

# Path to the bundled dataset (relative to the project root)
DATA_PATH=preprocessed_enforcement_data.csv

# Anomaly detection sensitivity (Isolation Forest contamination, 0.02-0.25)
ANOMALY_CONTAMINATION=0.08

# Default forecast horizon in months
FORECAST_MONTHS=6

# Optional: API key placeholder for future integrations (not required to run the app)
# API_KEY=your_api_key_here

# Streamlit runtime configuration
STREAMLIT_CLIENT_TOOLBAR_MODE=minimal
STREAMLIT_LOGGER_LEVEL=info
